# =============================================================================
# 飞书自动对话 Agent 后台 —— 环境变量示例
# 用法: cp .env.example .env,然后填写"必填"段,其余按需取消注释覆盖默认值。
# 注意: .env 已入 .gitignore,切勿提交真实密钥。
# 变量按进程分组:主服务(:8001) / 飞书操作台(:8000) / kb_service(:8002) /
# 外部 MCP 服务器(:8003)。四个进程同读项目根 .env,一份文件即可。
# =============================================================================

# ─────────────────────────────────────────────────────────────
# 1. LLM 主端点【必填,没它无法生成任何回复】
#    任何 OpenAI 兼容端点均可(deepseek/百炼兼容模式/自建 vllm 等)
# ─────────────────────────────────────────────────────────────
LLM_BASE_URL=https://api.deepseek.com        # 端点地址(含/不含 /v1 均可,框架自适配)
LLM_API_KEY=sk-填你的key                      # 端点 API Key
LLM_MODEL=deepseek-chat                       # 模型名;切视觉模型时同时把 VISION_ENABLED 置 true
# SYSTEM_PROMPT=你是一个有帮助的助手           # 全局系统提示词(默认即此)
# LLM_CONTEXT_WINDOW=128000                    # 模型上下文窗口(token),历史裁剪参考

# ─────────────────────────────────────────────────────────────
# 2. LLM 备份端点【可选】主端点启动探测失败时整体切换,三件套须配齐才生效
# ─────────────────────────────────────────────────────────────
# LLM_FALLBACK_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1   # 示例:阿里云百炼
# LLM_FALLBACK_API_KEY=sk-填你的备份key
# LLM_FALLBACK_MODEL=qwen-plus
# LLM_PROBE_TIMEOUT=6          # 启动探测总上限(秒)
# LLM_PROBE_SLOW_MS=2000       # 首个流式块超过该毫秒数判定主端点"半活"并切备份
# LLM_DISABLE_THINKING=true    # 按端点方言注入关思考参数(deepseek/百炼qwen),false 则思考全开

# ─────────────────────────────────────────────────────────────
# 3. 飞书操作台 feishu_console(:8000)【用飞书渠道必填;纯网页对话可留空】
#    飞书开放平台自建应用凭证,需开启"长连接"模式与 im 相关权限
# ─────────────────────────────────────────────────────────────
FEISHU_APP_ID=cli_填你的app_id
FEISHU_APP_SECRET=填你的app_secret
# PORT=8000                    # 操作台 Web 面板/API 端口(仅本机回环)

# ─────────────────────────────────────────────────────────────
# 4. 主服务渠道接线【可选】
# ─────────────────────────────────────────────────────────────
# CONSOLE_BASE_URL=http://localhost:8000   # 主服务连操作台的地址;显式置空则按纯网页对话运行
# AGENT_PORT=8001                          # 主服务(仪表盘)端口

# ─────────────────────────────────────────────────────────────
# 5. 会话与 workspace【可选,默认值已标注】
# ─────────────────────────────────────────────────────────────
# HISTORY_MAX_MESSAGES=10          # 短期历史窗口(消息条数,10≈5轮;更早上下文由长期记忆承接)
# WORKSPACE_READ_ONLY=true         # 只读试点:agent 文件 Action 只挂 read/search/list;
                                  # false 放开写权限(交付产物/分块写依赖它)
# ACTION_LOOP_MAX_ROUNDS=12        # Action 回路模型轮次预算(分块写大文件会多耗轮次)
# ACTION_LOOP_TIMEOUT=900          # 整个 Action 回路预算(秒;Node 工程型 skill 链需分钟级)
# ACTION_PROTOCOL=structured_plan  # 框架 action 协议,一般不改
# WORKSPACE_STORE_FILE=workspaces.json   # workspace 注册表落盘文件
# WORKSPACE_AUTO_ROOT=workspaces         # 飞书会话自动供给 workspace 的根目录
# SESSION_STORE_FILE=sessions.json       # 会话/turn 持久化文件
# FILE_MAX_BYTES=20971520                # 飞书附件下载上限(字节,默认 20MB;开 VL 建议 10485760)
# FILE_DELIVERY_MAX_BYTES=20971520       # 产物投递上限(字节)
# DELIVERY_MAX_ATTACHMENTS=10            # 单轮投递附件数护栏,超出自动打成 zip

# ─────────────────────────────────────────────────────────────
# 6. 视觉(VL)【可选;纯文本模型保持 false】
# ─────────────────────────────────────────────────────────────
# VISION_ENABLED=false   # 视觉总开关;切 VL 模型(如 deepseek-flash)时置 true,开错会生成报错
# IMAGE_DETAIL=auto      # VL 图片精度 low|high|auto,图片 token 贵时调 low
# IMAGE_PENDING_TTL=120  # 群聊"先发图后发文"软关联时间窗(秒)

# ─────────────────────────────────────────────────────────────
# 7. Skills【可选】
# ─────────────────────────────────────────────────────────────
# SKILLS_DIR=skills                  # 项目级 skill 目录
# WORKSPACE_SKILLS_DIR=skills        # 会话 workspace 内 skill 目录(按会话)
# SKILL_MODE=model_decision          # model_decision(模型选)|required(全量注入)
# SKILL_SCRIPTS_ENABLED=false        # skill 脚本 Docker 沙箱总开关;开启需 Docker 运行中+镜像预拉
# SKILL_SCRIPT_TIMEOUT=300           # 单次脚本执行上限(秒;Node 工程链渲染+导出需分钟级)
# SKILL_CONTEXT_MAX_CHARS=48000      # 选中 skill 正文投递预算(大 SKILL.md 需放宽)
# SKILL_CONTEXT_MAX_BLOCK_CHARS=24000
# SKILL_SCRIPT_IMAGE=agent-skill-python:3.12   # 脚本默认容器镜像(自构建见 SPEC「一次性环境准备」)
# SKILL_SCRIPT_BASE_IMAGE=docker.m.daocloud.io/library/python:3.12-slim  # sandbox.build 构建基座
# SKILL_SCRIPT_PIP_INDEX=https://pypi.org/simple                        # 构建期 pip 索引
# SKILL_SCRIPT_WORKSPACE_WRITE=false   # 容器内 workspace 读写挂载(需 WORKSPACE_READ_ONLY=false)

# ─────────────────────────────────────────────────────────────
# 8. 工具 MCP 服务器(外部独立项目,:8003)【接入外部服务器的接线变量】
#     自行部署兼容 MCP 服务器后用 MCP_SERVER_URL 指向它;
#     没有服务器时设 MCP_ENABLED=false 干净关闭,其余功能不受影响。
#     (工具组开关 WEB_ENABLED/AMAP_*/WEB_SEARCH_* 等是 MCP 服务器侧的
#      注册契约变量,本仓库代码不读取,见其自身项目的配置说明)
# ─────────────────────────────────────────────────────────────
# MCP_ENABLED=true                       # false = 完全不探测/不挂载(无 MCP 服务器时建议)
# MCP_SERVER_URL=http://127.0.0.1:8003   # 指向你部署的 MCP 服务器实例
# MCP_TIMEOUT=30                         # 单次工具调用上限(秒,含抓取)

# ─────────────────────────────────────────────────────────────
# 9. RAG 知识库【可选;主服务侧开关 + kb_service 侧配置】
# ─────────────────────────────────────────────────────────────
# KB_ENABLED=true                        # 主服务侧开关(需 kb_service 已启动)
# KB_SERVICE_URL=http://127.0.0.1:8002
# KB_TIMEOUT=10
# KB_MAX_RESULTS=5                       # 单次检索返回条数
# --- kb_service 进程自身 ---
# KB_SERVICE_HOST=127.0.0.1              # 仅本机回环
# KB_SERVICE_PORT=8002
# KB_DATA_DIR=kb_service/data            # RecordStore 落盘目录
# KNOWLEDGE_DIR=knowledge                # 启动扫描入库的全局知识库目录
# EMBEDDING_PROVIDER=fastembed           # fastembed(默认,轻量)|sentence_transformers(重)
# EMBEDDING_MODEL=BAAI/bge-small-zh-v1.5
# KB_CHUNK_SIZE=600                      # 分块目标字符数
# KB_CHUNK_OVERLAP=100
# KB_MAX_FILE_BYTES=2097152              # 单文件入库上限
# KB_SCAN_EXTENSIONS=.md,.txt,.markdown
# HF_ENDPOINT=https://hf-mirror.com      # 首次下载嵌入模型 HF 直连不通时启用镜像

# ─────────────────────────────────────────────────────────────
# 10. 跨会话长期记忆【可选;依赖 KB 链路可达】
# ─────────────────────────────────────────────────────────────
# MEMORY_ENABLED=false           # 记忆总开关
# MEMORY_AUTO_EXTRACT=false      # 轮后异步自动抽取(显式"记住:xxx"通道不受此开关影响)
# MEMORY_MIN_CONFIDENCE=0.8      # 自动抽取写入置信度门槛
# MEMORY_MAX_RECALL=5            # 每轮召回注入上限
# MEMORY_PROCESS_TTL_DAYS=3      # 过程状态类记忆有效期(天),长期事实为 0=永久

# ─────────────────────────────────────────────────────────────
# 11. 生成可靠性【可选】
# ─────────────────────────────────────────────────────────────
# VERIFY_MAX_RETRIES=1           # 产物验证重试环次数上限
# FACT_FOOTER_ENABLED=true       # 系统事实脚注(📎 已发送 / ⚠️ 未生成)
# INTENT_GATE_ENABLED=false      # 意图分类门(轻量分类,chitchat/ambiguous 不挂重能力)
# INTENT_GATE_TIMEOUT=5          # 意图分类超时(秒),超时 fail-open 为 task
